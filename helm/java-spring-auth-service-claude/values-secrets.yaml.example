# Template for the per-environment secrets overlay. Copy this to values-<env>.secrets.yaml
# (dev/test/production) and fill in real values - that file is gitignored (helm/**/values-*.secrets.yaml)
# and must never be committed. See docs/deployment.md for the full install command using both this
# file and values-<env>.yaml together.
#
#   cp values-secrets.yaml.example values-dev.secrets.yaml
#
# Generate a real RSA key pair the same way application.properties documents (its header comment
# has the full recipe and the LibreSSL/PKCS1-vs-PKCS8 gotcha to avoid) - don't invent a new one:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 | tr -d '\n'   # -> jwtPrivateKey
#   openssl pkey -in private.pem -pubout -outform DER | base64 | tr -d '\n'            # -> jwtPublicKey
#
# Use a different key pair per environment - don't reuse the same keys across dev/test/production,
# and never reuse the checked-in dev key from application.properties / k8s/secret.yaml for
# anything beyond that specific local demo (see CLAUDE.md's Continuous deployment section for why
# that existing checked-in key is a known, deliberately-out-of-scope shortcut, not a pattern to
# copy here).
secrets:
  jwtActiveKeyId: "dev-key-1"
  jwtKeyId: "dev-key-1"
  jwtPrivateKey: "FIXME-base64-DER-PKCS8-RSA-private-key"
  jwtPublicKey: "FIXME-base64-DER-X509-RSA-public-key"
  jwtExpirationMs: "3600000"
